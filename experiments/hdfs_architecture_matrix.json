{
  "name": "hdfs-architecture-matrix",
  "base_experiment": {
    "name": "hdfs-smoke-architecture-study",
    "suite": {
      "type": "hdfs",
      "settings": {
        "labels_csv": "data/hdfs/HDFS_anomaly_label_385_sampled_balanced.csv",
        "sessions_dir": "data/hdfs/HDFS_385_balanced_sampled_sessions",
        "sample_limit": 40,
        "seed": 42
      }
    },
    "runtime": {
      "profile": "hdfs_eval",
      "overrides": {}
    },
    "output_dir": "runs",
    "tags": {
      "suite": "hdfs",
      "study": "architecture"
    }
  },
  "axes": [
    {
      "name": "architecture",
      "values": [
        {
          "label": "single_pass",
          "patch": {
            "runtime": {
              "profile": "hdfs_single_pass_eval"
            },
            "tags": {
              "mode": "single_pass"
            }
          }
        },
        {
          "label": "agent",
          "patch": {
            "runtime": {
              "profile": "hdfs_agent_eval"
            },
            "tags": {
              "mode": "agent"
            }
          }
        },
        {
          "label": "planner",
          "patch": {
            "runtime": {
              "profile": "hdfs_planner_eval"
            },
            "tags": {
              "mode": "planner"
            }
          }
        },
        {
          "label": "pipeline",
          "patch": {
            "runtime": {
              "profile": "hdfs_eval"
            },
            "tags": {
              "mode": "pipeline"
            }
          }
        }
      ]
    },
    {
      "name": "model",
      "values": [
        {
          "label": "qwen3-4b",
          "patch": {
            "runtime": {
              "overrides": {
                "provider": "ollama",
                "model": "qwen3:4b-instruct"
              }
            }
          }
        },
        {
          "label": "gpt-4o-mini",
          "patch": {
            "runtime": {
              "overrides": {
                "provider": "openai",
                "model": "gpt-4o-mini"
              }
            }
          }
        }
      ]
    }
  ]
}
