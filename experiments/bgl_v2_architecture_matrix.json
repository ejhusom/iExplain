{
  "name": "bgl-v2-architecture-matrix",
  "base_experiment": {
    "name": "bgl-v2-full-architecture-study",
    "suite": {
      "type": "bgl_v2",
      "settings": {
        "log_file": "data/bgl/bgl_2k.log",
        "ground_truth_file": "data/bgl/ground_truth_v2.json",
        "tier": "full"
      }
    },
    "runtime": {
      "profile": "bgl_v2_eval",
      "overrides": {}
    },
    "output_dir": "runs",
    "tags": {
      "suite": "bgl_v2",
      "study": "architecture"
    }
  },
  "axes": [
    {
      "name": "architecture",
      "values": [
        {
          "label": "agent",
          "patch": {
            "runtime": {
              "profile": "bgl_v2_agent_eval"
            },
            "tags": {
              "mode": "agent"
            }
          }
        },
        {
          "label": "planner",
          "patch": {
            "runtime": {
              "profile": "bgl_v2_planner_eval"
            },
            "tags": {
              "mode": "planner"
            }
          }
        },
        {
          "label": "pipeline",
          "patch": {
            "runtime": {
              "profile": "bgl_v2_eval"
            },
            "tags": {
              "mode": "pipeline"
            }
          }
        }
      ]
    },
    {
      "name": "model",
      "values": [
        {
          "label": "qwen3-4b",
          "patch": {
            "runtime": {
              "overrides": {
                "provider": "ollama",
                "model": "qwen3:4b-instruct"
              }
            }
          }
        },
        {
          "label": "gpt-4o-mini",
          "patch": {
            "runtime": {
              "overrides": {
                "provider": "openai",
                "model": "gpt-4o-mini"
              }
            }
          }
        }
      ]
    }
  ]
}
